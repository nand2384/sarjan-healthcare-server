PORT=
NODE_ENV=
DATABASE_URL=

FRONTEND_URL=

DEFAULT_ADMIN_USERNAME=
DEFAULT_ADMIN_PASSWORD=
TRUST_PROXY=1

REDIS_URL=

# Optional — WhatsApp sending falls back to logging when unset.
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v20.0

# Optional — Deployed Version panel in the developer dashboard. Set at deploy
# time by your hosting platform; defaults to "unknown" if unset.
APP_VERSION=
GIT_COMMIT_SHA=

# Optional — file uploads (doctor photos etc.) return a clear "not
# configured" error when unset. Today: Supabase Storage's S3-compatible
# endpoint (Project Settings > Storage > S3 Connection). Later: point these
# at real AWS S3 instead — no code changes needed, same @aws-sdk/client-s3
# client either way.
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL_BASE=
