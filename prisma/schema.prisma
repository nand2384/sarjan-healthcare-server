// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  RESET_PASSWORD
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
  CHANGE_PASSWORD
  ENABLE
  DISABLE
  ACTIVATE_ACCOUNT
  RESEND_ACTIVATION_EMAIL
  CHANGE_ROLE
  FAILED_LOGIN_ATTEMPT
  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED
  SESSION_REVOKED_BY_ADMIN
}

enum AuditEntityType {
  STAFF
  DOCTOR
  PATIENT
  APPOINTMENT
  BILLING
  LABORATORY
  INVENTORY
  WEBSITE
  MASTER_DATA
  ROLE
  SYSTEM_SETTING
  SESSION
  RELEASE_NOTE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum QueueType {
  BOOKED
  WALK_IN
}

enum PasskeyDeviceType {
  SINGLE_DEVICE
  MULTI_DEVICE
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  ONLINE_GATEWAY // reserved for future gateway integration, unused for now
}

enum LineItemType {
  CONSULTATION
  TEST
}

model RoleMaster {
  role_id Int @id @default(autoincrement())

  role_name   String  @unique
  description String?

  display_order Int

  is_active Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  staff_roles StaffRole[]

  announcements Announcement[]

  @@map("role_master")
}

model MainMaster {
  master_id Int @id @default(autoincrement())

  master_name String  @unique
  description String?

  display_order Int?    @default(0)
  is_active     Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  values ValueMaster[]

  @@map("main_master")
}

model ValueMaster {
  value_id Int @id @default(autoincrement())

  master_id Int

  value_name  String
  description String?

  display_order Int
  is_active     Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  main_master MainMaster @relation(fields: [master_id], references: [master_id])

  staffs   Staff[]
  patients Patient[]

  appointment_statuses          Appointment[]                @relation("AppointmentStatus")
  visit_reasons                 Appointment[]                @relation("VisitReason")
  appointment_workflow_statuses AppointmentWorkflowHistory[] @relation("AppointmentWorkflowStatus")

  @@unique([master_id, value_name])
  @@index([master_id])
  @@map("value_master")
}

model Staff {
  staff_id Int @id @default(autoincrement())

  first_name String
  last_name  String

  username      String @unique
  mobile_number String @unique
  email         String @unique

  password_hash String?

  gender_id Int

  age Int?

  street_address String?
  city           String?
  state          String?
  pincode        String?

  profile_image_url String?

  is_disabled       Boolean @default(false)
  is_system_account Boolean @default(false)

  last_login_at DateTime?

  failed_login_count             Int       @default(0)
  failed_login_window_started_at DateTime?
  locked_until                    DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  is_account_activated Boolean @default(false)

  activation_token            String?   @unique
  activation_token_expires_at DateTime?

  password_reset_token            String?   @unique
  password_reset_token_expires_at DateTime?

  pending_email                    String?
  pending_email_token              String?   @unique
  pending_email_token_expires_at   DateTime?

  current_challenge    String?
  challenge_created_at DateTime?

  gender ValueMaster @relation(fields: [gender_id], references: [value_id])

  staff_roles    StaffRole[]
  sessions       Session[]
  audit_logs     AuditLog[]     @relation("StaffAuditLogs")
  doctor_profile DoctorProfile?

  doctor_availabilities DoctorAvailability[] @relation("DoctorAvailability")

  doctor_leaves DoctorLeave[] @relation("DoctorLeave")

  doctor_appointments Appointment[] @relation("DoctorAppointments")

  appointments_created Appointment[] @relation("AppointmentCreatedBy")

  appointment_workflow_changes AppointmentWorkflowHistory[] @relation("AppointmentWorkflowChangedBy")

  passkey_credentials PasskeyCredential[]

  notifications Notification[]

  announcements_created  Announcement[] @relation("AnnouncementCreatedBy")
  announcements_targeted Announcement[] @relation("AnnouncementTargetStaff")

  test_orders_placed TestOrder[] @relation("TestOrderedBy")

  payments_collected Payment[] @relation("PaymentCollectedBy")
  payments_refunded  Payment[] @relation("PaymentRefundedBy")

  reports_filed    Report[] @relation("ReportReportedBy")
  reports_resolved Report[] @relation("ReportResolvedBy")

  report_messages_sent ReportMessage[] @relation("ReportMessageSender")

  release_notes_created ReleaseNote[] @relation("ReleaseNoteCreatedBy")

  reviews_received Review[] @relation("ReviewDoctor")

  @@index([gender_id])
  @@index([username])
  @@index([email])
  @@map("staff")
}

model StaffRole {
  staff_role_id Int @id @default(autoincrement())

  staff_id Int
  role_id  Int

  is_default Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  staff Staff      @relation(fields: [staff_id], references: [staff_id])
  role  RoleMaster @relation(fields: [role_id], references: [role_id])

  @@unique([staff_id, role_id])
  @@index([staff_id])
  @@index([role_id])
  @@map("staff_role")
}

model Patient {
  patient_id Int @id @default(autoincrement())

  patient_account_id Int?

  uhid String @unique

  first_name  String
  middle_name String?
  last_name   String

  mobile_number       String?
  whatsapp_number     String?
  whatsapp_verified_at DateTime?
  email               String?

  gender_id Int?

  age Int?

  street_address String?
  city           String?
  state          String?
  pincode        String?

  referred_by String?

  is_account_complete Boolean @default(false)

  is_disabled Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  gender          ValueMaster?    @relation(fields: [gender_id], references: [value_id])
  patient_account PatientAccount? @relation(fields: [patient_account_id], references: [patient_account_id])
  appointments    Appointment[]   @relation("PatientAppointments")

  test_orders TestOrder[]
  payments    Payment[]
  reviews     Review[]

  otp_verifications PatientOtpVerification[]

  @@index([gender_id])
  @@index([patient_account_id])
  @@map("patient")
}

model PatientAccount {
  patient_account_id Int @id @default(autoincrement())

  mobile_number String @unique

  password_hash String?

  is_disabled Boolean @default(false)

  last_login_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  patients Patient[]

  @@map("patient_account")
}

model DoctorProfile {
  doctor_profile_id Int @id @default(autoincrement())

  staff_id Int @unique

  registration_number String? @unique

  specialization String

  qualification String

  biography String?

  profile_image_url String?

  experience String?

  display_order Int

  is_visible_on_website     Boolean @default(true)
  is_accepting_appointments Boolean @default(true)

  // Placeholder 0 on backfill for existing doctors — treated as "unset" by the billing module,
  // which blocks checkout and alerts admin until a real value is set via the pricing admin UI.
  old_case_fee Decimal @default(0) @db.Decimal(10, 2)
  new_case_fee Decimal @default(0) @db.Decimal(10, 2)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  staff Staff @relation(fields: [staff_id], references: [staff_id])

  @@index([staff_id])
  @@map("doctor_profile")
}

model Session {
  session_id String @id @default(cuid())

  staff_id Int
  staff    Staff @relation(fields: [staff_id], references: [staff_id])

  ip_address String?
  user_agent String?

  expires_at DateTime

  last_activity DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([staff_id])
  @@index([expires_at])
  @@map("session")
}

model AuditLog {
  audit_log_id BigInt @id @default(autoincrement())

  performed_by_staff_id Int?

  performed_by_staff Staff? @relation("StaffAuditLogs", fields: [performed_by_staff_id], references: [staff_id])

  entity_type AuditEntityType

  entity_id String

  action AuditAction

  old_values Json?
  new_values Json?

  ip_address String? @db.VarChar(45)
  user_agent String?

  created_at DateTime @default(now())

  @@index([performed_by_staff_id])
  @@index([entity_type])
  @@index([entity_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_log")
}

model PasskeyCredential {
  id String @id @default(cuid())

  staff_id Int

  credential_id String @unique
  public_key    Bytes

  counter BigInt

  transports String[]

  device_type PasskeyDeviceType

  backed_up Boolean

  device_name String?

  last_used_at DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  staff Staff @relation(fields: [staff_id], references: [staff_id], onDelete: Cascade)

  @@index([staff_id])
  @@map("passkey_credential")
}

model DoctorAvailability {
  doctor_availability_id Int @id @default(autoincrement())

  doctor_staff_id Int

  day_of_week DayOfWeek

  slot_name String

  start_time DateTime @db.Time(0)
  end_time   DateTime @db.Time(0)

  maximum_appointments Int

  display_order Int @default(0)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  doctor        Staff         @relation("DoctorAvailability", fields: [doctor_staff_id], references: [staff_id])
  doctor_leaves DoctorLeave[]
  appointments  Appointment[]

  @@index([doctor_staff_id])
  @@index([day_of_week])
  @@map("doctor_availability")
}

model DoctorLeave {
  doctor_leave_id Int @id @default(autoincrement())

  doctor_staff_id Int

  doctor_availability_id Int?

  start_date DateTime @db.Date
  end_date   DateTime @db.Date

  reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  doctor Staff @relation("DoctorLeave", fields: [doctor_staff_id], references: [staff_id])

  doctor_availability DoctorAvailability? @relation(fields: [doctor_availability_id], references: [doctor_availability_id])

  @@index([doctor_staff_id])
  @@index([doctor_availability_id])
  @@index([start_date])
  @@index([end_date])
  @@map("doctor_leave")
}

model Appointment {
  appointment_id Int @id @default(autoincrement())

  patient_id Int

  doctor_staff_id Int

  doctor_availability_id Int?

  appointment_status_id Int

  visit_reason_id Int

  created_by_staff_id Int

  appointment_date DateTime @db.Date

  appointment_remarks String?

  // Capped at 1 — enforced in ReceptionistService.rescheduleAppointment, not
  // just a display counter.
  reschedule_count Int @default(0)

  // Populated for every appointment at creation, same @default(cuid())
  // convention as Session.session_id — only ever sent to the patient once
  // checkout completes (see ReceptionistService.checkout), so an unused
  // token on a cancelled/no-show appointment is harmless.
  review_token String @unique @default(cuid())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  patient Patient @relation("PatientAppointments", fields: [patient_id], references: [patient_id])

  doctor Staff @relation("DoctorAppointments", fields: [doctor_staff_id], references: [staff_id])

  doctor_availability DoctorAvailability? @relation(fields: [doctor_availability_id], references: [doctor_availability_id])

  appointment_status ValueMaster @relation("AppointmentStatus", fields: [appointment_status_id], references: [value_id])

  visit_reason ValueMaster @relation("VisitReason", fields: [visit_reason_id], references: [value_id])

  created_by_staff Staff @relation("AppointmentCreatedBy", fields: [created_by_staff_id], references: [staff_id])

  appointment_workflow_history AppointmentWorkflowHistory[]

  queue Queue?

  test_orders TestOrder[]
  payment     Payment?
  review      Review?

  @@index([patient_id])
  @@index([doctor_staff_id])
  @@index([doctor_availability_id])
  @@index([appointment_status_id])
  @@index([visit_reason_id])
  @@index([created_by_staff_id])
  @@index([appointment_date])
  @@index([appointment_date, doctor_staff_id])
  @@index([appointment_date, appointment_status_id])
  @@map("appointment")
}

model AppointmentWorkflowHistory {
  appointment_workflow_history_id Int @id @default(autoincrement())

  appointment_id Int

  appointment_workflow_status_id Int

  changed_by_staff_id Int

  remarks String?

  created_at DateTime @default(now())

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])

  appointment_workflow_status ValueMaster @relation("AppointmentWorkflowStatus", fields: [appointment_workflow_status_id], references: [value_id])

  changed_by_staff Staff @relation("AppointmentWorkflowChangedBy", fields: [changed_by_staff_id], references: [staff_id])

  @@index([appointment_id])
  @@index([appointment_workflow_status_id])
  @@index([changed_by_staff_id])
  @@index([created_at])
  @@map("appointment_workflow_history")
}

model Queue {
  queue_id Int @id @default(autoincrement())

  appointment_id Int @unique

  queue_number Int

  queue_type QueueType

  joined_queue_at DateTime

  joined_after_consultation_sequence Int

  skip_count Int @default(0)

  is_active Boolean @default(true)

  created_at DateTime @default(now())

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])

  @@index([queue_type])
  @@index([joined_queue_at])
  @@index([is_active])
  @@map("queue")
}

model TestCatalog {
  test_catalog_id Int @id @default(autoincrement())

  test_name String
  price     Decimal @db.Decimal(10, 2)

  display_order Int     @default(0)
  is_active     Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  test_orders        TestOrder[]
  payment_line_items PaymentLineItem[]

  @@index([is_active])
  @@map("test_catalog")
}

model TestOrder {
  test_order_id Int @id @default(autoincrement())

  patient_id Int

  // Nullable: null when a patient walks in for a test only, with no doctor appointment.
  appointment_id Int?

  test_catalog_id Int

  // Receptionist (walk-in test-only order) or doctor (ordered during a consultation).
  ordered_by_staff_id Int

  ordered_at DateTime @default(now())

  patient          Patient      @relation(fields: [patient_id], references: [patient_id])
  appointment      Appointment? @relation(fields: [appointment_id], references: [appointment_id])
  test_catalog     TestCatalog  @relation(fields: [test_catalog_id], references: [test_catalog_id])
  ordered_by_staff Staff        @relation("TestOrderedBy", fields: [ordered_by_staff_id], references: [staff_id])

  payment_line_items PaymentLineItem[]

  @@index([patient_id])
  @@index([appointment_id])
  @@index([test_catalog_id])
  @@map("test_order")
}

model Payment {
  payment_id Int @id @default(autoincrement())

  patient_id Int

  // Nullable: null for a test-only checkout with no doctor appointment.
  appointment_id Int? @unique

  receipt_no String @unique // backend-generated, e.g. REC-20260730-0001; never entered manually

  // 'NEW' | 'OLD' snapshot at payment time, for audit/reprint accuracy. Null when the payment has
  // no consultation line item (test-only checkout).
  consultation_fee_type String?

  total_amount   Decimal       @db.Decimal(10, 2)
  payment_method PaymentMethod

  gateway_provider       String? // reserved for future
  gateway_transaction_id String? // reserved for future

  refund_amount        Decimal?  @db.Decimal(10, 2)
  refund_reason        String?
  refunded_by_staff_id Int?
  refunded_at          DateTime?

  collected_by_staff_id Int
  paid_at               DateTime @default(now())

  patient            Patient      @relation(fields: [patient_id], references: [patient_id])
  appointment        Appointment? @relation(fields: [appointment_id], references: [appointment_id])
  collected_by_staff Staff        @relation("PaymentCollectedBy", fields: [collected_by_staff_id], references: [staff_id])
  refunded_by_staff  Staff?       @relation("PaymentRefundedBy", fields: [refunded_by_staff_id], references: [staff_id])

  line_items PaymentLineItem[]

  @@index([patient_id])
  @@map("payment")
}

model PaymentLineItem {
  payment_line_item_id Int @id @default(autoincrement())

  payment_id Int

  item_type   LineItemType
  description String // snapshot label for receipt printing
  amount      Decimal      @db.Decimal(10, 2)

  // Set only when item_type = TEST, for traceability back to the catalog and the specific order billed.
  test_catalog_id Int?
  test_order_id   Int?

  payment      Payment      @relation(fields: [payment_id], references: [payment_id])
  test_catalog TestCatalog? @relation(fields: [test_catalog_id], references: [test_catalog_id])
  test_order   TestOrder?   @relation(fields: [test_order_id], references: [test_order_id])

  @@index([payment_id])
  @@map("payment_line_item")
}

model Notification {
  notification_id Int @id @default(autoincrement())

  staff_id Int

  title   String
  message String

  type String // e.g., 'INFO', 'WARNING', 'SUCCESS'

  is_read Boolean @default(false)

  // Optional link for frontend navigation
  action_url String?

  // Set when this notification was delivered as part of an announcement broadcast.
  // Lets a withdrawal retract every delivered copy instead of orphaning them.
  announcement_id Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  staff        Staff         @relation(fields: [staff_id], references: [staff_id])
  announcement Announcement? @relation(fields: [announcement_id], references: [announcement_id], onDelete: Cascade)

  @@index([staff_id])
  @@index([is_read])
  @@index([announcement_id])
  @@index([created_at])
  @@map("notification")
}

enum AnnouncementTargetType {
  STAFF
  ROLE
  ALL
}

model Announcement {
  announcement_id Int @id @default(autoincrement())

  message String
  type    String // 'info' | 'warning' | 'danger'

  target_type     AnnouncementTargetType
  target_staff_id Int?
  target_role_id  Int?

  is_active    Boolean   @default(true)
  withdrawn_at DateTime?

  email_sent Boolean @default(false)

  created_by_staff_id Int

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  created_by   Staff       @relation("AnnouncementCreatedBy", fields: [created_by_staff_id], references: [staff_id])
  target_staff Staff?      @relation("AnnouncementTargetStaff", fields: [target_staff_id], references: [staff_id])
  target_role  RoleMaster? @relation(fields: [target_role_id], references: [role_id])

  notifications Notification[]

  @@index([is_active])
  @@map("announcement")
}

// Admin-configurable runtime values (e.g. appointment reminder offset, walk-in
// queue-priority threshold) that would otherwise be hardcoded constants.
// Read-heavy keys are cached in Redis by SystemSettingService (mirrors
// MasterService's caching pattern) — this table is the source of truth, not
// the hot path.
model SystemSetting {
  setting_key   String   @id
  setting_value String
  updated_at    DateTime @updatedAt

  @@map("system_setting")
}

model PatientOtpVerification {
  otp_verification_id Int @id @default(autoincrement())

  // Nullable: OTP can be sent/verified before the patient record exists
  // (verification happens inline during registration, not after).
  patient_id Int?

  whatsapp_number String
  otp_code_hash   String
  expires_at      DateTime
  verified_at     DateTime?
  attempt_count   Int       @default(0)

  created_at DateTime @default(now())

  patient Patient? @relation(fields: [patient_id], references: [patient_id])

  @@index([whatsapp_number])
  @@index([patient_id])
  @@map("patient_otp_verification")
}

enum ReportType {
  BUG
  UPDATE
  FEATURE_REQUEST
}

enum ReportStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Report {
  report_id Int @id @default(autoincrement())

  report_type ReportType
  page_path   String
  page_label  String
  description String

  status          ReportStatus @default(OPEN)
  developer_notes String?

  reported_by_staff_id Int
  resolved_by_staff_id Int?
  resolved_at           DateTime?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  reported_by Staff  @relation("ReportReportedBy", fields: [reported_by_staff_id], references: [staff_id])
  resolved_by Staff? @relation("ReportResolvedBy", fields: [resolved_by_staff_id], references: [staff_id])

  messages ReportMessage[]

  @@index([status])
  @@map("report")
}

model ReportMessage {
  report_message_id Int @id @default(autoincrement())

  report_id Int
  sender_staff_id Int

  message String

  created_at DateTime @default(now())

  report Report @relation(fields: [report_id], references: [report_id])
  sender Staff  @relation("ReportMessageSender", fields: [sender_staff_id], references: [staff_id])

  @@index([report_id])
  @@map("report_message")
}

// Unified operational-event table — replaces what used to be three
// near-identical tables (JobRunLog/ErrorLog/DeliveryLog: each was just "an
// event row — what happened, when, success/failure, optional detail").
// `log_type` discriminates the kind of event; `subject` is that type's
// primary identifier (job name / request URL / delivery recipient);
// type-specific extras that don't need their own index live in `metadata`.
enum EventLogType {
  JOB_RUN
  ERROR
  DELIVERY
}

enum EventLogOutcome {
  RUNNING
  SUCCESS
  FAILED
}

model EventLog {
  event_log_id BigInt @id @default(autoincrement())

  log_type EventLogType
  outcome  EventLogOutcome

  subject String  // JOB_RUN: job name · ERROR: request URL · DELIVERY: recipient
  message String? // failure/error detail, if any

  // JOB_RUN: {} · ERROR: {request_id, method, status_code, stack} · DELIVERY: {channel, subject_or_template}
  metadata Json?

  started_at  DateTime  @default(now())
  finished_at DateTime?

  @@index([log_type])
  @@index([outcome])
  @@index([started_at])
  @@map("event_log")
}

model ReleaseNote {
  release_note_id Int @id @default(autoincrement())

  version_label String
  title         String
  body          String

  published_at DateTime @default(now())

  created_by_staff_id Int
  created_by_staff    Staff @relation("ReleaseNoteCreatedBy", fields: [created_by_staff_id], references: [staff_id])

  @@index([published_at])
  @@map("release_note")
}

// Admin-manageable rating parameters patients score 1-5 on — deliberately its
// own table (not the generic MainMaster/ValueMaster pattern) since it needs
// display_order and a description meaningfully tied to feedback specifically,
// and never a hard delete (is_active soft-delete, same convention as
// ValueMaster) so historical ReviewRating rows keep pointing at a real row.
model ReviewCriterion {
  criterion_id Int @id @default(autoincrement())

  label       String
  description String?

  display_order Int     @default(0)
  is_active     Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  ratings ReviewRating[]

  @@map("review_criterion")
}

enum ReviewSource {
  LINK
  RECEPTIONIST_QR
  PATIENT_DASHBOARD
}

model Review {
  review_id Int @id @default(autoincrement())

  appointment_id Int @unique
  patient_id     Int
  // Denormalized from the appointment at submission time — lets the admin
  // reviews list filter/query by doctor without joining through Appointment.
  doctor_staff_id Int

  message String?

  // Patient's own choice at submission; admin can flip it later from the
  // Patient Reviews page without touching the patient's original answer semantics.
  is_public Boolean @default(false)

  source ReviewSource

  submitted_at DateTime @default(now())

  appointment Appointment @relation(fields: [appointment_id], references: [appointment_id])
  patient     Patient     @relation(fields: [patient_id], references: [patient_id])
  doctor      Staff       @relation("ReviewDoctor", fields: [doctor_staff_id], references: [staff_id])

  ratings ReviewRating[]

  @@index([patient_id])
  @@index([doctor_staff_id])
  @@index([is_public])
  @@map("review")
}

model ReviewRating {
  review_rating_id Int @id @default(autoincrement())

  review_id    Int
  criterion_id Int
  stars        Int // 1-5

  review    Review          @relation(fields: [review_id], references: [review_id])
  criterion ReviewCriterion @relation(fields: [criterion_id], references: [criterion_id])

  @@unique([review_id, criterion_id])
  @@map("review_rating")
}
