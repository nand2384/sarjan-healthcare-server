// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model RoleMaster {
  role_id BigInt @id @default(autoincrement())

  role_name   String  @unique
  description String?

  display_order Int

  is_active Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  staff_roles StaffRole[]

  @@map("role_master")
}

model MainMaster {
  master_id BigInt @id @default(autoincrement())

  master_name String  @unique
  description String?

  display_order Int?
  is_active     Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  values ValueMaster[]

  @@map("main_master")
}

model ValueMaster {
  value_id BigInt @id @default(autoincrement())

  master_id BigInt

  value_name  String
  description String?

  display_order Int
  is_active     Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  main_master MainMaster @relation(fields: [master_id], references: [master_id])

  staffs   Staff[]
  patients Patient[]

  @@unique([master_id, value_name])
  @@index([master_id])
  @@map("value_master")
}

model Staff {
  staff_id BigInt @id @default(autoincrement())

  first_name String
  last_name  String

  username String @unique
  mobile_number String @unique
  email         String @unique

  password_hash String?

  gender_id BigInt

  age Int?

  street_address String?
  city           String?
  state          String?
  pincode        String?

  profile_image_url String?

  is_disabled Boolean @default(false)
  is_system_account Boolean @default(false)

  last_login_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  gender ValueMaster @relation(fields: [gender_id], references: [value_id])

  staff_roles    StaffRole[]
  sessions Session[]
  doctor_profile DoctorProfile?

  @@index([gender_id])
  @@map("staff")
}

model StaffRole {
  staff_role_id BigInt @id @default(autoincrement())

  staff_id BigInt
  role_id  BigInt

  is_default Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  staff Staff      @relation(fields: [staff_id], references: [staff_id])
  role  RoleMaster @relation(fields: [role_id], references: [role_id])

  @@unique([staff_id, role_id])
  @@index([staff_id])
  @@index([role_id])
  @@map("staff_role")
}

model Patient {
  patient_id BigInt @id @default(autoincrement())

  patient_account_id BigInt?

  uhid String @unique

  first_name String
  last_name  String

  mobile_number   String?
  whatsapp_number String?
  email           String?

  gender_id BigInt

  age Int?

  street_address String?
  city           String?
  state          String?
  pincode        String?

  is_disabled Boolean @default(false)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  gender          ValueMaster     @relation(fields: [gender_id], references: [value_id])
  patient_account PatientAccount? @relation(fields: [patient_account_id], references: [patient_account_id])

  @@index([gender_id])
  @@index([patient_account_id])
  @@map("patient")
}

model PatientAccount {
  patient_account_id BigInt @id @default(autoincrement())

  mobile_number String @unique

  password_hash String?

  is_disabled Boolean @default(false)

  last_login_at DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  patients Patient[]

  @@map("patient_account")
}

model DoctorProfile {
  doctor_profile_id BigInt @id @default(autoincrement())

  staff_id BigInt @unique

  registration_number String? @unique

  specialization String

  qualification String

  biography String?

  profile_image_url String?

  experience String?

  display_order Int

  is_visible_on_website     Boolean @default(true)
  is_accepting_appointments Boolean @default(true)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  staff Staff @relation(fields: [staff_id], references: [staff_id])

  @@index([staff_id])
  @@map("doctor_profile")
}

model Session {
  session_id String @id @default(cuid())

  staff_id BigInt
  staff    Staff @relation(fields: [staff_id], references: [staff_id])

  ip_address String?
  user_agent String?

  expires_at DateTime

  last_activity DateTime @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([staff_id])
  @@index([expires_at])
  @@map("session")
}
