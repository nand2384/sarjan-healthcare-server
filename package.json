{
    "name": "sarjan-healthcare-server",
    "version": "1.0.0",
    "description": "Backend server for Sarjan Healthcare, built with Node.js, Express, TypeScript, and Prisma. Designed with a scalable architecture featuring authentication, authorization, middleware, logging, REST APIs, and a modular structure for healthcare management, appointments, EMR, billing, and more.",
    "keywords": [
        "healthcare",
        "hospital-management",
        "backend",
        "nodejs",
        "express",
        "typescript",
        "prisma",
        "postgresql",
        "rest-api",
        "authentication",
        "authorization",
        "webauthn",
        "passkeys",
        "medical-records",
        "appointment-system"
    ],
    "homepage": "https://github.com/nand2384/sarjan-healthcare-server#readme",
    "bugs": {
        "url": "https://github.com/nand2384/sarjan-healthcare-server/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nand2384/sarjan-healthcare-server.git"
    },
    "license": "ISC",
    "author": "Nand Patel",
    "type": "commonjs",
    "main": "src/server.js",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "prepare": "husky",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.8.0",
        "@prisma/client": "^7.8.0",
        "bcrypt": "^6.0.0",
        "compression": "^1.8.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "helmet": "^8.2.0",
        "node-cron": "^4.5.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "prisma": "^7.8.0",
        "redis": "^6.1.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.1.0",
        "@commitlint/config-conventional": "^21.1.0",
        "@eslint/js": "^10.0.1",
        "@types/bcrypt": "^6.0.0",
        "@types/compression": "^1.8.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/node": "^26.0.1",
        "eslint": "^10.5.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.6",
        "globals": "^17.7.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.8.4",
        "tsx": "^4.22.4",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    },
    "lint-staged": {
        "*.{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml}": [
            "prettier --write"
        ]
    }
}
